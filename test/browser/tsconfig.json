// The browser cases' in-page modules, checked against the declarations this repository's dist/
// ships rather than the sources, which would declare the same custom elements twice. The
// foundation's sheets type as its ./css types subpath declares them, as the sources' do. Beside
// them, support/types.js, which no page runs, holds values typed by those declarations, so one
// that narrows what a consumer may write fails here.
// From spike-html-packages-components (4c0a5d8): test/browser/tsconfig.json.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": ["support/probe.js", "support/restyle.js", "support/types.js"]
}
