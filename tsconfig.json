// The build, src/ into dist/: tsc emits each module's .js and .d.ts. mise run types checks the same
// sources with --noEmit. The foundation is read as a consumer reads it, through the install of
// the peer at the top level, here its devDependency: its shipped .d.ts, and the ambient "*.css"
// declaration its ./css types subpath holds.
// Adapted from spike-html-packages-components (4c0a5d8): tsconfig.json, renamed.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@jaimestill/spike-html-apps-foundation/css"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src"]
}
